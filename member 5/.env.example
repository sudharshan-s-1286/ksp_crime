# KSP Crime Copilot — Environment Variables
# Copy this to .env and fill in your real values. Never commit .env to git.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ksp_crime_db

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── FAISS ─────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=/data/faiss/crime_index.faiss
FAISS_METADATA_PATH=/data/faiss/crime_metadata.json

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
